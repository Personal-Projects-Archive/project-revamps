    {
        "id": "fn_build_neo",
        "type": "function",
        "z": "esp32_iot_tab",
        "name": "Couleur -> fields",
        "func": "var parts = msg.payload.toString().split(\",\");\nmsg.payload = [\n    {\n        neopixel_r: parseInt(parts[0]),\n        neopixel_g: parseInt(parts[1]),\n        neopixel_b: parseInt(parts[2])\n    },\n    { device: \"esp32_01\" }\n];\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 520,
        "wires": [
            [
                "influx_out"
            ]
        ]
    },
    {
        "id": "mqtt_out_neo",
        "type": "mqtt out",
        "z": "esp32_iot_tab",
        "name": "-> lights/neopixel",
        "topic": "lights/neopixel",
        "qos": "1",
        "retain": "",
        "broker": "broker_public",
        "x": 620,
        "y": 520,
        "wires": []
    },
    {
        "id": "influx_out",
        "type": "influxdb out",
        "z": "esp32_iot_tab",
        "influxdb": "db936eeba350cfd1",
        "name": "Ecrire esp32_iot",
        "measurement": "esp32_iot",
        "precision": "",
