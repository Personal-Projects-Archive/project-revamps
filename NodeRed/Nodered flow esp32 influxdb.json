[
    {
        "id": "esp32_iot_tab",
        "type": "tab",
        "label": "ESP32 -> InfluxDB (sans dashboard)",
        "disabled": false,
        "info": "Chaine IoT : MQTT -> parse -> InfluxDB. Grafana fait toute la visualisation.",
        "env": []
    },
    {
        "id": "mqtt_in_temp",
        "type": "mqtt in",
        "z": "esp32_iot_tab",
        "name": "Tempdata (ESP32)",
        "topic": "Tempdata",
        "qos": "2",
        "datatype": "auto",
        "broker": "broker_public",
        "inputs": 0,
        "x": 140,
        "y": 100,
        "wires": [
            [
                "fn_parse_temp"
            ]
        ]
    },
    {
        "id": "fn_parse_temp",
        "type": "function",
        "z": "esp32_iot_tab",
        "name": "Parser temp/hum -> fields",
        "func": "var input = msg.payload.toString().trim();\nvar parts = input.split(\",\");\nvar temperature = parseFloat(parts[0]);\nvar humidity = parseFloat(parts[1]);\n\nmsg.payload = [\n    { temperature: temperature, humidity: humidity },\n    { device: \"esp32_01\" }\n];\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 100,
        "wires": [
            [
                "influx_out"
            ]
        ]
    },
    {
        "id": "inj_led_on",
        "type": "inject",
        "z": "esp32_iot_tab",
        "name": "LED ON",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": "",
        "topic": "",
        "payload": "ON",
        "payloadType": "str",
        "x": 140,
        "y": 200,
        "wires": [
            [
                "mqtt_out_lights",
                "fn_build_led"
            ]
        ]
    },
    {
        "id": "inj_led_off",
        "type": "inject",
        "z": "esp32_iot_tab",
        "name": "LED OFF",
        "topic": "",
        "payload": "OFF",
        "payloadType": "str",
        "x": 140,
        "y": 240,
        "wires": [
            [
                "mqtt_out_lights",
                "fn_build_led"
            ]
        ]
    },
    {
        "id": "fn_build_led",
        "type": "function",
        "z": "esp32_iot_tab",
        "name": "Etat LED -> field",
        "func": "var state = (msg.payload === \"ON\") ? 1 : 0;\nmsg.payload = [\n    { led: state },\n    { device: \"esp32_01\" }\n];\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 220,
        "wires": [
            [
                "influx_out"
            ]
        ]
    },
    {
        "id": "mqtt_out_lights",
        "type": "mqtt out",
        "z": "esp32_iot_tab",
        "name": "-> lights",
        "topic": "lights",
        "qos": "1",
        "retain": "",
        "broker": "broker_public",
        "x": 620,
        "y": 220,
        "wires": []
    },
    {
        "id": "inj_servo_0",
        "type": "inject",
        "z": "esp32_iot_tab",
        "name": "Servo 0 degres",
        "topic": "",
        "payload": "0",
        "payloadType": "str",
        "x": 140,
        "y": 320,
        "wires": [
            [
                "mqtt_out_servo",
                "fn_build_servo"
