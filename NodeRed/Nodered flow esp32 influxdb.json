    {
        "id": "inj_servo_180",
        "type": "inject",
        "z": "esp32_iot_tab",
        "name": "Servo 180 degres",
        "topic": "",
        "payload": "180",
        "payloadType": "str",
        "x": 140,
        "y": 400,
        "wires": [
            [
                "mqtt_out_servo",
                "fn_build_servo"
            ]
        ]
    },
    {
        "id": "fn_build_servo",
        "type": "function",
        "z": "esp32_iot_tab",
        "name": "Angle servo -> field",
        "func": "var angle = parseInt(msg.payload);\nmsg.payload = [\n    { servo_angle: angle },\n    { device: \"esp32_01\" }\n];\nreturn msg;",
        "outputs": 1,
        "x": 380,
        "y": 360,
        "wires": [
            [
                "influx_out"
            ]
        ]
    },
    {
        "id": "mqtt_out_servo",
        "type": "mqtt out",
        "z": "esp32_iot_tab",
        "name": "-> servo",
        "topic": "servo",
        "qos": "1",
        "retain": "",
        "broker": "broker_public",
        "x": 620,
        "y": 360,
        "wires": []
    },
    {
        "id": "inj_neo_255_0_0",
